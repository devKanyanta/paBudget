DATABASE_URL=postgresql://pabudget@localhost:5433/pabudget
PORT=4000
JWT_SECRET=change-me
PUBLIC_URL=http://localhost:4000
# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cloudflare R2 (leave empty to store images on local disk in ./uploads)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
# First admin created by `npm run seed`
ADMIN_EMAIL=admin@pabudget.local
ADMIN_PASSWORD=ChangeMe123!

# Optional error reporting (Sentry)
SENTRY_DSN=
# Planner requests per user per day
PLANNER_PER_DAY=10
